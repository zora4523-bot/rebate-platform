root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Generated SQL is committed byte-for-byte (pnpm db:check compares it); an editor that trims
# trailing whitespace would make the snapshot drift.
[db/schema.sql]
trim_trailing_whitespace = false

[db/migrations/0002_pgboss-schema-v42.sql]
trim_trailing_whitespace = false
