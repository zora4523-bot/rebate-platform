# 本地开发环境变量示例。复制为 .env 后使用（.env 已被 git 忽略，只有本文件入库）。
# 真实密钥永不进本仓库的 .env：联盟、短信、打款、模型的真实密钥只放私有库
# rebate-private/probe.env，由负责人在终端运行探测脚本时加载（规划/11 §6、§8）。
# APP_ENV 为 local 或 test 时，联盟、短信、打款适配器只能是假实现。
# 下面的口令都是本地栈专用的固定值，只在 127.0.0.1 上有效，不是密钥。

# ---- 应用 ----
# local | test | staging | prod（应用启动必填）
APP_ENV=local
LOG_LEVEL=info
# 固定时钟：带时区偏移的 ISO-8601 时刻；进程时钟 = 该时刻 + 启动后流逝的真实时间。
# 只在 local / test / staging 生效；prod 设置了就拒绝启动（ADR-0001 §4.2 第 10 项）。
# CLOCK_NOW=2026-10-01T09:00:00+08:00
# 设为 1 时入口完成初始化后直接退出（不监听端口），供冒烟检查使用。
# COULI_EXIT_AFTER_INIT=1
API_HOST=127.0.0.1
API_PORT=3100
STREAM_PORT=3101
ADMIN_PORT=3102

# ---- 本地栈（pnpm dev:stack；compose 项目 couli-local，全部只绑 127.0.0.1）----
COULI_DB_LOCAL_PASSWORD=couli_local
# 业务角色 couli_app
DATABASE_URL=postgres://couli_app:couli_local@127.0.0.1:54329/couli
# 只读角色 couli_readonly：admin 入口的报表只读句柄 dbRead（admin 必填，其他入口不读）。
# 生产指向只读从库；本地栈没有从库，指向同一个库。
DATABASE_READ_URL=postgres://couli_readonly:couli_local@127.0.0.1:54329/couli
# 分区维护角色 couli_maint；只有 worker 读取，专用连接池大小为 1。
DATABASE_MAINT_URL=postgres://couli_maint:couli_local@127.0.0.1:54329/couli
# 迁移角色 couli_migrator（只跑迁移）
MIGRATOR_DATABASE_URL=postgres://couli_migrator:couli_local@127.0.0.1:54329/couli
# 超级用户，只用于本地初始化（建角色、建扩展）
PG_ADMIN_URL=postgres://postgres:couli_local@127.0.0.1:54329/postgres
REDIS_URL=redis://127.0.0.1:63790

# ---- 短信（BR-ID-05）----
# local / test 只用假短信适配器：验证码只进进程内发件箱，不打日志，也没有固定验证码。
# 短信通道的变量一律 SMS_ 开头；已声明的真实凭证变量是 SMS_ALIYUN_ACCESS_KEY_ID、
# SMS_ALIYUN_ACCESS_KEY_SECRET，APP_ENV 为 local 或 test 时设置了任何一个就拒绝启动。本文件不放它们。

# ---- 登录令牌（BR-ID-07，api 入口的 access_token ES256 签名密钥）----
# local / test 不设时，进程启动生成一对临时 P-256 密钥（重启后旧令牌一律 10002）；staging / prod
# 必须设置，否则拒绝启动。私钥永不写进本文件：JWT_PRIVATE_KEY_PEM 是 PKCS#8 PEM 原文（P-256，
# openssl 默认输出的 SEC1 格式要先用 `openssl pkcs8 -topk8 -nocrypt` 转换），只在部署环境注入。
# JWT_KEY_ID 与它成对出现（写进每个令牌头的 kid，1–64 位 A-Z a-z 0-9 . _ ~ -）。
# 轮换时把旧 kid 的公钥（SPKI PEM）放进 JWT_VERIFY_KEYS_JSON（{"旧kid":"公钥 PEM"}），只用于验旧令牌。
# JWT_KEY_ID=
# JWT_VERIFY_KEYS_JSON=

# ---- 测试 ----
# 一次性测试库的超级用户连接串，只给 globalSetup 用；不设时由 Testcontainers 起容器（需要 Docker）。
# TEST_PG_ADMIN_URL=
# 属性测试次数与种子（规划/11 §4.2）；统计写入 PROP_STATS_FILE 指向的文件。
PROP_RUNS=10000
PROP_SEED=20261001
# PROP_STATS_FILE=

# ---- 编排工具（tools/）----
# 运行产物目录，默认 <仓库>/../couli-runs
# COULI_RUNS=
# 规划仓库目录，默认 <仓库>/../couli
# COULI_SPEC_REPO=
# 门禁脚本的可信副本；couli-runs/trusted/rebate-platform 建好前默认用主检出（永远不能指向
# couli-runs/worktrees/ 下的任务 worktree，脚本会拒绝）
# COULI_TRUSTED_ROOT=
# 编排会话的名字（领任务时记为 owner_session；同一会话才能续期自己的认领）
# COULI_SESSION=
# 只由 tools/agent/codex-run.sh 设置，不要手动设置
# COULI_CODEX_WRAPPER=1
# 超时后先 TERM、再 KILL 之间的等待秒数（上限 5，只能调小）
COULI_KILL_GRACE_SECS=5

# ---- 编排工具的可选开关（都只能收紧，不设即用默认值）----
# 验证容器 verify-container.sh：整次 pnpm verify 的时限秒数（默认与上限都是 1200）与容器 / 网络 / 镜像名前缀
# COULI_VERIFY_TIMEOUT_SECS=1200
# COULI_VERIFY_PREFIX=couli-verify
# codex-run.sh：把总时限、无输出时限调小（只能调小，测试与首跑自检用）
# COULI_CODEX_TIMEOUT_SECS=
# COULI_CODEX_IDLE_SECS=
# PreToolUse 拦截钩子（tools/guard/hooks/INSTALL.md）：=1 时把「需确认」一律当拒绝
# COULI_HOOK_ASK_AS_DENY=1
# =project 时，其他项目里的 codex exec 改为确认而不是拒绝
# COULI_HOOK_CODEX_SCOPE=project
# codex 垫片（tools/guard/shim/INSTALL.md）：用冒号分隔的目录清单，替换默认的保护目录
# COULI_SHIM_GUARD_DIRS=
