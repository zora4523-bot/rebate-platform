# 本地开发环境变量示例。复制为 .env 后使用（.env 已被 git 忽略，只有本文件入库）。
# 真实密钥永不进本仓库的 .env：联盟、短信、打款、模型的真实密钥只放私有库
# rebate-private/probe.env，由负责人在终端运行探测脚本时加载（规划/11 §6、§8）。
# APP_ENV 为 local 或 test 时，联盟、短信、打款适配器只能是假实现。
# 下面的口令都是本地栈专用的固定值，只在 127.0.0.1 上有效，不是密钥。

# ---- 应用 ----
# local | test | staging | prod（应用启动必填）
APP_ENV=local
LOG_LEVEL=info
# 固定时钟：带时区偏移的 ISO-8601 时刻；进程时钟 = 该时刻 + 启动后流逝的真实时间。
# 只在 local / test / staging 生效；prod 设置了就拒绝启动（ADR-0001 §4.2 第 10 项）。
# CLOCK_NOW=2026-10-01T09:00:00+08:00
# 设为 1 时入口完成初始化后直接退出（不监听端口），供冒烟检查使用。
# COULI_EXIT_AFTER_INIT=1
# 部署版本（镜像 tag）：设置后每行日志带 deployVersion 字段；不设或为空就不输出该字段。
# 预发由 infra/staging/compose.yaml 用 deploy.sh 导出的 COULI_API_TAG 传入；本地一般不设。
# COULI_DEPLOY_VERSION=local-dev
API_HOST=127.0.0.1
API_PORT=3100
STREAM_PORT=3101
ADMIN_PORT=3102
# Prometheus /metrics（内网专用，不进 OAS）：设了 METRICS_PORT（1024–65535）各入口才另开一个只答
# GET /metrics 的端口；worker 导出队列与同步水位指标，其余入口只有进程级指标。不设就不监听。
# METRICS_HOST 缺省 127.0.0.1；容器里给抓取方访问时设为容器内网地址，不要映射到宿主公网。
# METRICS_PORT=9464
# METRICS_HOST=127.0.0.1

# ---- 本地栈（pnpm dev:stack；compose 项目 couli-local，全部只绑 127.0.0.1）----
COULI_DB_LOCAL_PASSWORD=couli_local
# 业务角色 couli_app
DATABASE_URL=postgres://couli_app:couli_local@127.0.0.1:54329/couli
# 只读角色 couli_readonly：admin 入口的报表只读句柄 dbRead（admin 必填，其他入口不读）。
# 生产指向只读从库；本地栈没有从库，指向同一个库。
DATABASE_READ_URL=postgres://couli_readonly:couli_local@127.0.0.1:54329/couli
# 分区维护角色 couli_maint；只有 worker 读取，专用连接池大小为 1。
DATABASE_MAINT_URL=postgres://couli_maint:couli_local@127.0.0.1:54329/couli
# 迁移角色 couli_migrator（只跑迁移）
MIGRATOR_DATABASE_URL=postgres://couli_migrator:couli_local@127.0.0.1:54329/couli
# 超级用户，只用于本地初始化（建角色、建扩展）
PG_ADMIN_URL=postgres://postgres:couli_local@127.0.0.1:54329/postgres
REDIS_URL=redis://127.0.0.1:63790

# ---- 短信（BR-ID-05）----
# local / test 只用假短信适配器：验证码只进进程内发件箱，不打日志，也没有固定验证码。
# 短信通道的变量一律 SMS_ 开头；阿里云短信读 SMS_ACCESS_KEY_ID、SMS_ACCESS_KEY_SECRET、SMS_SIGN_NAME、
# SMS_TEMPLATE_VERIFY_CODE（只在 staging / prod 读，四个齐才启用），APP_ENV 为 local 或 test 时设置了任何一个
# 就拒绝启动。本文件不放它们。

# ---- 拼多多联盟真实适配器（B1-04t）----
# 只在 staging 使用：两个变量必须同时设置，config/union-endpoints 里 pdd 为 live 时才读取；
# 后者是节点上只有服务账号可读的文件路径，文件内容是 client_secret，入口启动时读一次。
# APP_ENV 为 local 或 test 时设置了任何一个就拒绝启动；prod 只认 KMS，设置文件路径即拒绝启动。
# 本文件永不放它们的值。
# PDD_CLIENT_ID=
# PDD_CLIENT_SECRET_FILE=

# ---- 淘宝联盟真实适配器（B1-04k）----
# 只在 staging 使用：两个变量必须同时设置，config/union-endpoints 里 taobao 为 live 时才读取（为 live 而两个都没设则淘宝保持未实现）；
# 后者是节点上只有服务账号可读的文件路径，文件内容是 app_secret，入口启动时读一次。
# APP_ENV 为 local 或 test 时设置了任何一个就拒绝启动；prod 只认 KMS，设置文件路径即拒绝启动。
# 本文件永不放它们的值。
# TAOBAO_APP_KEY=
# TAOBAO_APP_SECRET_FILE=

# ---- 大淘客订单源（B1-04e）----
# 淘宝真实适配器的订单 / 维权 / 违规数据源。只在 APP_ENV=staging 且淘宝为 live 时生效，两个变量必须同时设置；
# 后者是节点上只有服务账号可读的文件路径，文件内容是大淘客 appSecret，入口启动时读一次。
# 两个都不设时淘宝照常启动、不带订单源。APP_ENV 为 local 或 test 时设置了任何一个就拒绝启动；
# prod 只认 KMS，设置文件路径即拒绝启动。本文件永不放它们的值。
# DATAOKE_APP_KEY=
# DATAOKE_APP_SECRET_FILE=

# ---- 淘宝大淘客开关（B1-04zn）----
# 淘宝转链 / 搜索的数据源，默认都不走大淘客。只在淘宝为 live 且大淘客订单源就位时才生效，否则保持未实现。
# 不是密钥；任何 APP_ENV 都可设，取值以外（含大小写不同）拒绝启动。
# 转链：baichuan（默认）或 dataoke。
# TAOBAO_CONVERT_SOURCE=
# 搜索：official（默认，官方接口批下前保持未实现）或 dataoke。
# TAOBAO_SEARCH_SOURCE=

# ---- 京东联盟真实适配器（B1-04ze）----
# 只在 staging 使用：两个变量必须同时设置，config/union-endpoints 里 jd 为 live 时才读取（为 live 而两个都没设则京东保持未实现）；
# 后者是节点上只有服务账号可读的文件路径，文件内容是 app_secret，入口启动时读一次。
# APP_ENV 为 local 或 test 时设置了任何一个就拒绝启动；prod 只认 KMS，设置文件路径即拒绝启动。
# 本文件永不放它们的值。
# JD_APP_KEY=
# JD_APP_SECRET_FILE=
# 京东网站 id（十进制正整数文本），转链用。不是密钥；任何环境不设都能启动，设了但不合法则拒绝启动。
# JD_SITE_ID=

# ---- 拼多多商品查询身份（B1-04x）----
# 商品接口（搜索、详情、精选、链接识别）带的 custom_parameters：JSON 对象文本，按 UTF-8 不超过 64 字节，
# 原样使用；推广位取各 app 在 union_pids 里 active 的拼多多查询推广位（每个查询推广位都要用同一 uid 备案）。
# 不是密钥；任何环境不设都能启动，pdd 为 live 时启动告警一次、商品调用被拒绝。设了但不合法则拒绝启动。
# PDD_QUERY_CUSTOM_PARAMETERS=

# ---- 联盟端点覆盖目录（B1-04y）----
# 只有 APP_ENV=staging 认：绝对路径，联盟模块启动时改从该目录读 jd.json、pdd.json、taobao.json（同样校验，
# 缺文件即启动失败，不退回 config/union-endpoints/）。其他环境设了就拒绝启动。本地不设。
# UNION_ENDPOINT_OVERRIDE_DIR=

# ---- 登录令牌（BR-ID-07，api 入口的 access_token ES256 签名密钥）----
# local / test 不设时，进程启动生成一对临时 P-256 密钥（重启后旧令牌一律 10002）；staging / prod
# 必须设置，否则拒绝启动。私钥永不写进本文件：JWT_PRIVATE_KEY_PEM 是 PKCS#8 PEM 原文（P-256，
# openssl 默认输出的 SEC1 格式要先用 `openssl pkcs8 -topk8 -nocrypt` 转换），只在部署环境注入。
# JWT_KEY_ID 与它成对出现（写进每个令牌头的 kid，1–64 位 A-Z a-z 0-9 . _ ~ -）。
# 轮换时把旧 kid 的公钥（SPKI PEM）放进 JWT_VERIFY_KEYS_JSON（{"旧kid":"公钥 PEM"}），只用于验旧令牌。
# 只验签的进程（stream）按最小权限只给 JWT_KEY_ID + JWT_PUBLIC_KEY_PEM（当前 kid 的公钥，SPKI PEM，
# 标签 PUBLIC KEY，P-256），不给私钥；staging / prod 公钥私钥都缺即拒绝启动。只给私钥时由私钥导出公钥
# （兼容现有部署）；公钥与私钥同给时必须是同一对。签发进程（api）缺私钥照旧拒绝启动。值只在部署环境注入。
# JWT_KEY_ID=
# JWT_PUBLIC_KEY_PEM=
# JWT_VERIFY_KEYS_JSON=

# ---- 后台登录（BR-ID-34，admin 入口）----
# ADMIN_TOKEN_SIGNING_KEY：admin_token 的 HS256 签名密钥（base64url、无填充，解码后至少 32 字节），
# 与上面的 App 令牌密钥分开；local / test 不设时进程启动随机生成（重启后旧令牌一律失效）。
# ADMIN_IP_ALLOWLIST：后台允许的来源 IP 或网段（逗号分隔，最多 50 条，如 192.0.2.10,198.51.100.0/24）；
# local / test 不设时只放回环地址。staging / prod 两项都必须设置，否则 admin 入口拒绝启动。
# ADMIN_CORS_ORIGIN：后台前端的确切来源（如 https://admin.example.com，不带路径）；不设则不开 CORS。
# 密钥永不写进本文件，只在部署环境注入。
# ADMIN_TOKEN_SIGNING_KEY=
# ADMIN_IP_ALLOWLIST=
# ADMIN_CORS_ORIGIN=

# ---- 媒体存储（BR-TEXT-24，平台标识等图片按内容 SHA-256 命名）----
# MEDIA_PUBLIC_BASE_URL：媒体文件的 https 公网前缀（不带查询与片段）；local / test 不设时用保留域名，staging / prod 不设时上传与取地址按请求失败。
# MEDIA_PUBLIC_BASE_URL=

# ---- 私有导出存储（BR-ID-34 后台导出，exports 桶私有、只给限时签名链接）----
# EXPORT_STORE_BASE_URL：签名下载链接的 https 前缀（不带查询、片段与账号）；local / test 不设时用保留域名 https://exports.local.invalid。
# EXPORT_STORE_SIGNING_KEY：local / test 内存替身给链接做 HMAC 签名的密钥，不进日志；不设时用仅供本地的公开测试密钥。
# staging / prod 两项缺省仍能启动；未接 OSS 适配器（B1-30）前每次写入与签链接按请求失败 50001。
# EXPORT_STORE_BASE_URL=
# EXPORT_STORE_SIGNING_KEY=

# ---- 测试 ----
# 一次性测试库的超级用户连接串，只给 globalSetup 用；不设时由 Testcontainers 起容器（需要 Docker）。
# TEST_PG_ADMIN_URL=
# 属性测试次数与种子（规划/11 §4.2）；统计写入 PROP_STATS_FILE 指向的文件。
PROP_RUNS=10000
PROP_SEED=20261001
# PROP_STATS_FILE=

# ---- 真实收款通道（B2-15k，BR-PAY-08）----
# 只有 api、worker、admin 入口读，stream、payout 永远不读；local / test 一律假通道，下面的凭据名设了任何一个就拒绝启动。
# staging 用测试商户或沙箱：微信要 PAY_WECHAT_TEST_MERCHANT 设为 1，支付宝要 PAY_ALIPAY_GATEWAY 且不能是生产网关；否则该渠道不可用。
# prod 网关固定为官方地址，设 PAY_ALIPAY_GATEWAY 或 PAY_CHANNEL_IMPL 即拒绝启动。PAY_CHANNEL_IMPL 只接受 fake；PAY_NOTIFY_BASE_URL 必须 https。
# 缺配置不拒绝启动：该渠道装成不可用（下单 50306、通知不处理），不回退假通道。
# *_FILE 是节点上只有服务账号可读的文件路径（PEM；APIv3 密钥文件只放 32 字节密钥原文），入口启动时读一次。
# 支付宝二选一：PAY_ALIPAY_PUBLIC_KEY_FILE，或证书三件 PAY_ALIPAY_APP_CERT_FILE、PAY_ALIPAY_PUBLIC_CERT_FILE、PAY_ALIPAY_ROOT_CERT_FILE。
# 本文件永不放它们的值。
# PAY_APP_ID=
# PAY_CHANNEL_IMPL=
# PAY_NOTIFY_BASE_URL=
# PAY_WECHAT_APPID=
# PAY_WECHAT_MCHID=
# PAY_WECHAT_MERCHANT_SERIAL=
# PAY_WECHAT_PRIVATE_KEY_FILE=
# PAY_WECHAT_APIV3_KEY_FILE=
# PAY_WECHAT_PUBLIC_KEY_FILE=
# PAY_WECHAT_PUBLIC_KEY_ID=
# PAY_WECHAT_TEST_MERCHANT=
# PAY_ALIPAY_APPID=
# PAY_ALIPAY_SELLER_ID=
# PAY_ALIPAY_PRIVATE_KEY_FILE=
# PAY_ALIPAY_PUBLIC_KEY_FILE=
# PAY_ALIPAY_APP_CERT_FILE=
# PAY_ALIPAY_PUBLIC_CERT_FILE=
# PAY_ALIPAY_ROOT_CERT_FILE=
# PAY_ALIPAY_GATEWAY=

# ---- 编排工具（tools/）----
# 运行产物目录，默认 <仓库>/../couli-runs
# COULI_RUNS=
# 规划仓库目录，默认 <仓库>/../couli
# COULI_SPEC_REPO=
# 门禁脚本的可信副本；couli-runs/trusted/rebate-platform 建好前默认用主检出（永远不能指向
# couli-runs/worktrees/ 下的任务 worktree，脚本会拒绝）
# COULI_TRUSTED_ROOT=
# 编排会话的名字（领任务时记为 owner_session；同一会话才能续期自己的认领）
# COULI_SESSION=
# 只由 tools/agent/codex-run.sh 设置，不要手动设置
# COULI_CODEX_WRAPPER=1
# 超时后先 TERM、再 KILL 之间的等待秒数（上限 5，只能调小）
COULI_KILL_GRACE_SECS=5

# ---- 编排工具的可选开关（都只能收紧，不设即用默认值）----
# 验证容器 verify-container.sh：整次 pnpm verify 的时限秒数（默认与上限都是 1200）与容器 / 网络 / 镜像名前缀
# COULI_VERIFY_TIMEOUT_SECS=1200
# COULI_VERIFY_PREFIX=couli-verify
# codex-run.sh：把总时限、无输出时限调小（只能调小，测试与首跑自检用）
# COULI_CODEX_TIMEOUT_SECS=
# COULI_CODEX_IDLE_SECS=
# PreToolUse 拦截钩子（tools/guard/hooks/INSTALL.md）：=1 时把「需确认」一律当拒绝
# COULI_HOOK_ASK_AS_DENY=1
# =project 时，其他项目里的 codex exec 改为确认而不是拒绝
# COULI_HOOK_CODEX_SCOPE=project
# codex 垫片（tools/guard/shim/INSTALL.md）：用冒号分隔的目录清单，替换默认的保护目录
# COULI_SHIM_GUARD_DIRS=
