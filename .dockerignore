# Build context for infra/staging/Dockerfile (B1-01zc). Only source and the lockfile go in:
# dependencies are installed inside the image from pnpm-lock.yaml, build output is rebuilt.

# environment files and key material never enter the image (规划/11 §8)
.env
.env*
**/.env
**/.env*
*.env
**/*.env
*.pem
**/*.pem
*.key
**/*.key
*.crt
**/*.crt
*.p12
**/*.p12
*.pfx
**/*.pfx
*.keystore
**/*.keystore
*.jks
**/*.jks
**/keyring*.json
**/id_rsa*
**/id_ecdsa*
**/id_ed25519*
**/id_dsa*
**/.ssh

# version control and orchestration workspaces
.git
.github
couli-runs
**/couli-runs

# local dependencies and build output: rebuilt from the lockfile inside the image
node_modules
**/node_modules
**/dist
**/*.tsbuildinfo
.turbo
**/.turbo

# test scratch space, coverage and reports
**/.tmp
**/coverage
**/reports
.DS_Store
**/.DS_Store
