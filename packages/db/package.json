{
  "name": "@couli/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "couli-src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "couli-src": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./testing/global-setup": {
      "couli-src": "./src/testing/global-setup.ts",
      "types": "./dist/testing/global-setup.d.ts",
      "default": "./dist/testing/global-setup.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "bootstrap": "node scripts/bootstrap.ts",
    "migrate": "node scripts/migrate.ts",
    "partitions": "node scripts/partitions.ts",
    "seed": "node scripts/seed.ts",
    "snapshot": "node scripts/snapshot.ts",
    "check": "node scripts/snapshot.ts --check",
    "gen:pgboss": "node scripts/gen-pgboss-migration.ts",
    "dev:stack": "node scripts/dev-stack.ts up",
    "dev:stack:down": "node scripts/dev-stack.ts down"
  },
  "dependencies": {
    "kysely": "0.29.6",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "kysely-codegen": "0.20.0",
    "node-pg-migrate": "9.0.0",
    "pg-boss": "12.34.0",
    "testcontainers": "12.1.0"
  }
}
