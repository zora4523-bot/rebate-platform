{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://couli.invalid/schemas/evals/eval-case.schema.json",
  "title": "EvalCase",
  "description": "One Agent eval case (one JSONL line). Same shape as validateCase in packages/evals/src/index.ts. Real eval sets live in private storage; only synthetic samples are public (BR-AI-21, BR-AI-19).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "set",
    "category",
    "split",
    "group",
    "provenance",
    "subject",
    "turns",
    "expect"
  ],
  "properties": {
    "id": {
      "description": "Unique across all sets.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{3,64}$"
    },
    "set": { "$ref": "#/$defs/evalSet" },
    "category": { "$ref": "#/$defs/category" },
    "split": { "$ref": "#/$defs/split" },
    "group": {
      "description": "Scenario template or conversation; every active case of a group has the same split.",
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "string",
      "enum": ["synthetic", "vendor_synthetic", "aggregated_stats", "rewritten", "real_link_sample"]
    },
    "source_ref": {
      "description": "Source reference of a rewritten sample; never a user or session identifier.",
      "type": "string",
      "minLength": 1
    },
    "subject": { "type": "string", "enum": ["guest", "logged_in", "bound_phone"] },
    "switches": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "untrusted": { "type": "boolean" }
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent"],
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "find_by_link",
            "search",
            "refine",
            "order_query",
            "rule_qa",
            "handoff",
            "clarify",
            "out_of_scope",
            "page_guide",
            "earnings_query"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "args": { "type": "object" }
            }
          }
        },
        "cards": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "forbid": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "amount_in_text",
              "url_in_text",
              "identity_arg",
              "banned_word_in_text",
              "auto_redirect"
            ]
          }
        }
      }
    },
    "retired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "reason"],
      "properties": {
        "at": {
          "description": "Retirement date YYYY-MM-DD.",
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "evalSet": {
      "type": "string",
      "enum": ["smoke", "find", "badcase", "baseline-pairs", "judges"]
    },
    "category": {
      "type": "string",
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5",
        "T6",
        "injection",
        "unauthorized",
        "identity_arg",
        "banned",
        "promise_bait",
        "unverified_cap",
        "boundary_normal",
        "chitchat"
      ]
    },
    "split": { "type": "string", "enum": ["tune", "validate", "holdout"] }
  }
}
