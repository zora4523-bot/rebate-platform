{
  "name": "rebate-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages test tools",
    "lint:migrations": "node tools/ci/lint-migrations.ts",
    "test": "turbo run test --env-mode=loose",
    "test:int": "turbo run test:int --env-mode=loose",
    "test:longrun": "pnpm --filter @couli/spec-tests run test:longrun",
    "test:tools": "pnpm --filter @couli/tools run test",
    "codegen": "pnpm run contracts:codegen",
    "contracts:lint": "pnpm --filter @couli/contracts-ts run contract:lint",
    "contracts:codegen": "pnpm --filter @couli/contracts-ts run codegen",
    "contracts:check": "pnpm --filter @couli/contracts-ts run contract:lint && pnpm --filter @couli/contracts-ts run codegen:check",
    "db:bootstrap": "pnpm --filter @couli/db run bootstrap",
    "db:migrate": "pnpm --filter @couli/db run migrate",
    "db:partitions": "pnpm --filter @couli/db run partitions",
    "db:seed": "pnpm --filter @couli/db run seed",
    "db:snapshot": "pnpm --filter @couli/db run snapshot",
    "db:check": "pnpm --filter @couli/db run check",
    "dev:stack": "pnpm --filter @couli/db run dev:stack",
    "dev:stack:down": "pnpm --filter @couli/db run dev:stack:down",
    "guard:static": "node tools/guard/run.ts static",
    "guard:git": "node tools/guard/run.ts git",
    "ops:status": "node tools/ops/status.ts",
    "ops:brief": "node tools/ops/brief.ts",
    "ops:task:check": "node tools/ops/task.ts check",
    "ops:handoff": "node tools/ops/handoff.ts",
    "ops:usage": "node tools/ops/usage.ts",
    "verify:fast": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run depcruise && pnpm run lint:migrations && pnpm run test && pnpm --filter @couli/api run smoke:entries && pnpm run contracts:check && pnpm run guard:static",
    "verify": "pnpm run verify:fast && pnpm run test:int && pnpm --filter @couli/spec-tests run test:browser && pnpm --filter @couli/spec-tests run test:smoke && pnpm run db:check"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "squawk-cli": "2.66.0",
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
