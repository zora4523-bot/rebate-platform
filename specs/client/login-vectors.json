  "agreement": [
    {
      "name": "initial_unchecked",
      "steps": [],
      "expect": { "showConfirm": false, "proceed": false, "consentRecorded": false }
    },
    {
      "name": "unchecked_requires_confirm",
      "steps": [{ "op": "tapLogin" }],
      "expect": { "showConfirm": true, "proceed": false, "consentRecorded": false }
    },
    {
      "name": "cancel_does_not_proceed",
      "steps": [{ "op": "tapLogin" }, { "op": "cancelConfirm" }],
      "expect": { "showConfirm": false, "proceed": false, "consentRecorded": false }
    },
    {
      "name": "confirm_records_click",
      "steps": [{ "op": "tapLogin" }, { "op": "confirmAgree" }],
      "expect": { "showConfirm": false, "proceed": true, "consentRecorded": true }
    },
    {
      "name": "check_records_without_submitting",
      "steps": [{ "op": "check" }],
      "expect": { "showConfirm": false, "proceed": false, "consentRecorded": true }
    },
    {
      "name": "checked_login_uses_check_time",
      "steps": [{ "op": "check" }, { "op": "tapLogin" }],
      "expect": { "showConfirm": false, "proceed": true, "consentRecorded": true }
    },
    {
      "name": "uncheck_requires_new_confirmation",
      "steps": [
        { "op": "check" },
        { "op": "uncheck" },
        { "op": "tapLogin" },
        { "op": "confirmAgree" }
      ],
      "expect": { "showConfirm": false, "proceed": true, "consentRecorded": true }
    },
    {
      "name": "cancel_then_retry_still_requires_confirm",
      "steps": [{ "op": "tapLogin" }, { "op": "cancelConfirm" }, { "op": "tapLogin" }],
      "expect": { "showConfirm": true, "proceed": false, "consentRecorded": false }
    },
    {
      "name": "cancel_then_manual_check",
      "steps": [
        { "op": "tapLogin" },
        { "op": "cancelConfirm" },
        { "op": "check" },
        { "op": "tapLogin" }
      ],
      "expect": { "showConfirm": false, "proceed": true, "consentRecorded": true }
    },
    {
      "name": "unchecked_uncheck_does_not_consent",
      "steps": [{ "op": "uncheck" }, { "op": "tapLogin" }],
      "expect": { "showConfirm": true, "proceed": false, "consentRecorded": false }
    }
