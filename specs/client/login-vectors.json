  "smsSend": [
    {
      "name": "success_at_epoch_zero",
      "response": { "code": 0 },
      "nowMillis": 0,
      "expect": { "countdownSec": 60, "canResend": false, "stateRaw": "code_sent" }
    },
    {
      "name": "success_at_non_round_epoch",
      "response": { "code": 0 },
      "nowMillis": 1700000000123,
      "expect": { "countdownSec": 60, "canResend": false, "stateRaw": "code_sent" }
    },
    {
      "name": "rate_limit_60",
      "response": { "code": 42901, "headers": { "Retry-After": "60" } },
      "nowMillis": 1700000000123,
      "expect": {
        "countdownSec": 60,
        "canResend": false,
        "stateRaw": "rate_limited",
        "textKey": "error.42901"
      }
    },
    {
      "name": "rate_limit_61",
      "response": { "code": 42901, "headers": { "Retry-After": "61" } },
      "nowMillis": 1700000000123,
      "expect": {
        "countdownSec": 61,
        "canResend": false,
        "stateRaw": "rate_limited",
        "textKey": "error.42901"
      }
    },
    {
      "name": "rate_limit_3600",
      "response": { "code": 42901, "headers": { "Retry-After": "3600" } },
      "nowMillis": 1700000000123,
      "expect": {
        "countdownSec": 3600,
        "canResend": false,
        "stateRaw": "rate_limited",
        "textKey": "error.42901"
      }
    },
    {
      "name": "rate_limit_86400",
      "response": { "code": 42901, "headers": { "Retry-After": "86400" } },
      "nowMillis": 1700000000123,
      "expect": {
        "countdownSec": 86400,
        "canResend": false,
        "stateRaw": "rate_limited",
        "textKey": "error.42901"
      }
