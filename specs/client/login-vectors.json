  "codeAutoSubmit": [
    {
      "name": "sixth_digit_submits_once_with_phone_page_check_time",
      "steps": [
        { "op": "check" },
        { "op": "getCode", "step": "code", "confirm": null },
        { "op": "input", "code": "1", "submits": false },
        { "op": "input", "code": "12", "submits": false },
        { "op": "input", "code": "123", "submits": false },
        { "op": "input", "code": "1234", "submits": false },
        { "op": "input", "code": "12345", "submits": false },
        { "op": "input", "code": "123456", "submits": true },
        { "op": "respond", "code": 0, "current": true }
      ],
      "expect": { "requests": [{ "code": "123456", "consentAtStep": 0 }], "sends": 1 }
    },
    {
      "name": "pasted_six_digits_submit_once_then_20002_clears_without_resubmit",
      "steps": [
        { "op": "check" },
        { "op": "getCode", "step": "code", "confirm": null },
        { "op": "input", "code": "123456", "submits": true },
        { "op": "input", "code": "123456", "submits": false },
        { "op": "respond", "code": 20002, "current": true },
        { "op": "field", "value": "" },
        { "op": "input", "code": "654321", "submits": true },
        { "op": "respond", "code": 20002, "current": true },
        { "op": "field", "value": "" }
      ],
      "expect": {
        "requests": [
          { "code": "123456", "consentAtStep": 0 },
          { "code": "654321", "consentAtStep": 0 }
        ],
        "sends": 1
      }
    },
    {
      "name": "rate_limited_42901_keeps_cells_and_no_submit_until_retry_after",
      "steps": [
        { "op": "check" },
        { "op": "getCode", "step": "code", "confirm": null },
        { "op": "input", "code": "111111", "submits": true },
        { "op": "respond", "code": 20002, "current": true },
        { "op": "input", "code": "222222", "submits": true },
        { "op": "respond", "code": 42901, "retryAfter": "30" },
        { "op": "field", "value": "222222" },
        { "op": "advance", "ms": 20000 },
        { "op": "input", "code": "333333", "submits": false },
        { "op": "advance", "ms": 4000 },
        { "op": "input", "code": "444444", "submits": false },
        { "op": "advance", "ms": 5000 },
        { "op": "input", "code": "555555", "submits": true },
        { "op": "respond", "code": 0 }
      ],
      "expect": {
        "requests": [
          { "code": "111111", "consentAtStep": 0 },
          { "code": "222222", "consentAtStep": 0 },
          { "code": "555555", "consentAtStep": 0 }
        ],
        "sends": 1
      }
    },
    {
      "name": "late_20002_does_not_touch_new_partial_code",
      "steps": [
        { "op": "check" },
        { "op": "getCode", "step": "code", "confirm": null },
        { "op": "input", "code": "111111", "submits": true },
        { "op": "input", "code": "22222", "submits": false },
        { "op": "respond", "code": 20002, "current": false },
        { "op": "field", "value": "22222" }
      ],
      "expect": { "requests": [{ "code": "111111", "consentAtStep": 0 }], "sends": 1 }
    },
    {
      "name": "late_20003_does_not_touch_new_complete_code_and_input_in_flight_is_not_queued",
      "steps": [
        { "op": "check" },
        { "op": "getCode", "step": "code", "confirm": null },
        { "op": "input", "code": "111111", "submits": true },
        { "op": "input", "code": "222222", "submits": false },
        { "op": "respond", "code": 20003, "current": false },
        { "op": "field", "value": "222222" }
      ],
      "expect": { "requests": [{ "code": "111111", "consentAtStep": 0 }], "sends": 1 }
    },
    {
      "name": "g12_complete_code_typed_in_flight_is_not_queued_after_20002",
      "steps": [
        { "op": "check" },
        { "op": "getCode", "step": "code", "confirm": null },
        { "op": "input", "code": "111111", "submits": true },
        { "op": "input", "code": "222222", "submits": false },
        { "op": "respond", "code": 20002, "current": false },
        { "op": "field", "value": "222222" },
        { "op": "input", "code": "22222", "submits": false },
        { "op": "input", "code": "333333", "submits": true },
        { "op": "respond", "code": 0 }
      ],
      "expect": {
        "requests": [
          { "code": "111111", "consentAtStep": 0 },
          { "code": "333333", "consentAtStep": 0 }
