{
  "$comment": "ExternalNavigationPolicy test vectors (08 BR-ATTR-29 ② and 细则; 03 §5.1). Shared by the three apps; the server does not use them. Synthetic rule tables with reserved .test domains (real hosts come from specs/link-patterns.yaml, B1-07). Matching follows the syntax notes of specs/link-patterns.yaml.",
  "version": 1,
  "inputs": {
    "frame": "initial (first URL the container opens) | main | subframe | new_window",
    "switches": "features.flags external_page.union_host_block (null = unreadable, treated as on) and external_page.product_intercept",
    "basic_mode": "basic mode (BR-ID-01): no device signature, inputs/parse cannot be called",
    "download": "the response is a download (attachment, unrenderable type, blob:, data:)",
    "tables": "which rule tables the client has, in the order current (/v1/config.link_patterns) → last_good → bundled"
  },
  "outputs": {
    "action": "allow | parse (cancel, send the URL without fragment to POST /v1/inputs/parse) | block (cancel; subframe: that frame is not loaded) | cancel (non-https or download; nothing is handed to the system)",
    "notice": "union_host_blocked (BR-TEXT-14 external_page.union_host_blocked) | download (external_page.download_blocked or download_unsupported, by can_open_in_browser) | null",
    "table_used": "the table the decision was made with"
  },
  "rule_tables": {
    "current": {
      "version": "synthetic-1",
      "rules": [
        {
          "platform": "taobao",
          "category": "union_host",
          "hosts": ["shop-a.test", "mall-a.test"],
          "path_patterns": []
        },
        {
          "platform": "taobao",
          "category": "product",
          "hosts": ["item.shop-a.test"],
          "path_patterns": ["/item.htm"]
        },
        {
          "platform": "taobao",
          "category": "product",
          "hosts": ["detail.mall-a.test"],
          "path_patterns": ["/item/*.htm"]
        },
        {
          "platform": "taobao",
          "category": "promo",
          "hosts": ["s.click-a.test"],
          "path_patterns": ["/**"]
        },
        {
          "platform": "jd",
          "category": "union_host",
          "hosts": ["shop-b.test"],
          "path_patterns": []
        },
        {
          "platform": "jd",
          "category": "product",
          "hosts": ["item.shop-b.test", "m.shop-b.test"],
          "path_patterns": ["/*.html", "/product/*.html"]
        },
        {
          "platform": "pdd",
          "category": "union_host",
          "hosts": ["shop-c.test"],
          "path_patterns": []
        },
        {
          "platform": "pdd",
          "category": "promo",
          "hosts": ["p.shop-c-link.test"],
          "path_patterns": ["/x/**"]
        }
      ]
    },
    "bundled": {
      "version": "bundled-1",
      "rules": [
        {
          "platform": "taobao",
          "category": "union_host",
          "hosts": ["shop-a.test", "mall-a.test"],
          "path_patterns": []
        },
        {
          "platform": "jd",
          "category": "union_host",
          "hosts": ["shop-b.test"],
          "path_patterns": []
        },
        {
          "platform": "pdd",
          "category": "union_host",
          "hosts": ["shop-c.test"],
          "path_patterns": []
        }
      ]
    }
  },
