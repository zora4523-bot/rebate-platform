{
  "$comment": "ExternalNavigationPolicy test vectors (08 BR-ATTR-29 ② and 细则; 03 §5.1). Shared by the three apps; the server does not use them. Synthetic rule tables with reserved .test domains (real hosts come from specs/link-patterns.yaml, B1-07). Matching follows the syntax notes of specs/link-patterns.yaml.",
  "version": 1,
  "inputs": {
    "frame": "initial (first URL the container opens) | main | subframe | new_window",
    "switches": "features.flags external_page.union_host_block (null = unreadable, treated as on) and external_page.product_intercept",
    "basic_mode": "basic mode (BR-ID-01): no device signature, inputs/parse cannot be called",
    "download": "the response of an allowed navigation is a download (attachment, unrenderable type); a blob: or data: URL is already cancelled by its scheme",
    "order": "scheme (only https) → well-formed https URL (no user info, parsable; otherwise cancel, fail closed) → rule table: union_host hit with a product hit, top-level frame, product_intercept on and not basic mode → parse; other union_host hits → block while union_host_block is on (null = on) → download → allow",
    "matching": "host lower-cased, trailing dot removed, port ignored; path decoded once (valid %XX only, other % kept literally), case-sensitive, ** matches anything including newlines",
    "tables": "which rule tables the client has, in the order current (/v1/config.link_patterns) → last_good → bundled"
  },
  "outputs": {
    "action": "allow (a new window opens in the current container) | parse (cancel, send parse_url to POST /v1/inputs/parse) | block (cancel; subframe: that frame is not loaded) | cancel (non-https, not a well-formed https URL, or a download; nothing is handed to the system)",
    "notice": "union_host_blocked (BR-TEXT-14 external_page.union_host_blocked) | download (external_page.download_blocked when the current page has a system-browser exit, otherwise external_page.download_unsupported; the current page is not part of these vectors) | null",
    "parse_url": "the URL without its fragment, only for parse",
    "table_used": "the table the decision was made with"
  },
