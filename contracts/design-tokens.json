        },
        "solid": {
          "background": {
            "type": "color",
            "value": "#C44820",
            "description": "狸橙实底（钱包主卡等），只承载白字；24 以上大字或实底卡片使用，不做渐变或整屏色块"
          },
          "text": {
            "type": "color",
            "value": "#FFFFFF",
            "description": "狸橙实底上的白字，含金额大字与卡内次要文字，不用半透明白"
          }
        }
