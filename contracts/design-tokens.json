        }
      },
      "rebate": {
        "text": {
          "type": "color",
          "value": "#A83B1F",
          "description": "返利金额与其标签词（预估返、推广收益）的强调文字，用于白底、米白底与 rebate.background 上"
        },
        "background": {
          "type": "color",
          "value": "#FBEFE8",
