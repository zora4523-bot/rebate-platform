    "share.open": {
      "level": "L1",
      "model": "async",
      "timeout_ms": null,
      "phase": "M-内测",
      "since": {
        "ios": "1.0.0",
        "android": "1.0.0",
        "harmony": "1.0.0"
      },
      "note": "content.type=link: content.url is first normalised (standard URL parsing; unparsable, non-https or with user info → 90403; host lower-cased, trailing dot removed, port 443 removed; path percent-decoded exactly once), then checked in order, each step final: (1) matches any category of link_patterns → 90403; (2) host in /v1/config.share_domains (full host match) → only the share page paths of share_page_paths pass, a non-default port or any other path → 90403 without going on; (3) any other https address passes. On 90403 no share panel is shown. Normalisation and order are kept only in BR-ATTR-29 细则「桥方法不留没有归因的打开入口」. A WeChat channel when WeChat is not installed opens a panel of the available channels with a hint instead of an error (BR-ID-04 细则「未安装微信时」)",
      "whitelist_90403": "content.url outside the allowed range (link_patterns hit, or a non-share-page path on a share domain; BR-ATTR-29 细则)",
      "share_page_paths": {
        "$comment": "Path patterns of the three share pages on share_domains, registered once here and taken by the generators into the three apps (04 §9 方法的补充约束; BR-ATTR-29 细则). path_pattern is an anchored regular expression over the normalised path; null = not fixed yet: 规划/01 §4.2 gives these pages no route or path, so the values come with the pages' routes.",
        "product_share": {
          "page": "商品分享中间页 (path carries the server-issued link_id)",
          "path_pattern": null
        },
        "invite_landing": {
          "page": "邀请落地页",
          "path_pattern": null
        },
        "download_guide": {
          "page": "下载引导页",
          "path_pattern": null
        }
      },
      "params": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "channel": {
            "type": "string",
            "enum": ["wechat_session", "wechat_timeline", "system"]
          },
          "content": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["link"]
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https://",
                    "maxLength": 2048
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "desc": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "thumb": {
                    "type": "string",
                    "pattern": "^https://",
                    "maxLength": 2048
                  }
                },
                "required": ["type", "url", "title"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["image"]
                  },
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^https://",
                      "maxLength": 2048
                    },
                    "minItems": 1,
                    "maxItems": 9
                  }
                },
                "required": ["type", "images"]
              }
            ]
          },
          "show_panel": {
            "type": "boolean"
          }
        },
        "required": ["content"]
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "shared": {
            "type": "boolean"
          }
        },
        "required": ["shared"]
      }
