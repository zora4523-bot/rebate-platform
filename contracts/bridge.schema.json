{
  "$comment": "JSBridge contract (CT-03). Methods: 规划/04 §9; protocol, levels, error codes: 规划/03 §5.3. Generated types: packages/contracts-ts/src/bridge.gen.ts. Clients call has() before any method (拍板第二批 TECH-28).",
  "version": 1,
  "envelope": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "type": "integer",
          "enum": [1]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object"
        }
      },
      "required": ["v", "id", "method"]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "code": {
          "type": "integer",
          "description": "0 = success; bridge errors use 90001–90500"
        },
        "msg": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      },
      "required": ["id", "code", "msg"]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        }
      },
      "required": ["event"]
    }
  },
  "levels": {
    "L0": "Whitelisted origin, main frame",
    "L1": "L0 + logged in",
    "L2": "L1 + user gesture within the last 1 second"
  },
  "errors": {
    "90001": "Method does not exist or is not supported",
    "90002": "Invalid params",
    "90003": "Timeout",
    "90004": "Cancelled by the user",
    "90401": "Not logged in",
    "90403": "Origin or frame not allowed, or method + path outside signed_paths",
    "90404": "User gesture missing",
    "90500": "Native internal error"
  },
  "signed_paths": [
    {
      "method": "POST",
      "path": "/v1/orders/claims"
    }
  ],
  "not_exposed": [
    "withdrawal",
    "payout account change",
    "labor agreement signing",
    "real-name verification",
    "account deletion",
    "phone number change"
  ],
  "events": {
