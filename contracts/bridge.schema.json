{
  "$comment": "JSBridge contract (CT-03). Methods: 规划/04 §9; protocol, levels, error codes: 规划/03 §5.3. Generated types: packages/contracts-ts/src/bridge.gen.ts. Clients call has() before any method (拍板第二批 TECH-28). Besides level and gesture, every call passes the force-update guard of 03 §4.4 (04 §9 header): while the update check is unknown, read-only methods run as usual, nav.open (and trade.openProduct) only opens the read-only pages of the BR-ID-10 细则「路由入口矩阵」, and every other method ends with 90500; below the minimum version the 03 §4.4 state table applies. A method added later belongs to the third class (90500) unless 03 §4.4 lists it. gesture_required: a non-L2 method that still needs a user click within the last 1 second (same check as L2; missing → 90404). whitelist_90403: the method's own whitelist rejection, answered with 90403 at the same place as the origin, frame and level checks (03 §5.3).",
  "version": 1,
  "envelope": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "type": "integer",
          "enum": [1]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["v", "id", "method"]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "code": {
          "type": "integer",
          "description": "0 = success; bridge errors use 90001–90500"
        },
        "msg": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["id", "code", "msg"]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "description": "Event data never carries clipboard content, tokens, signing material or device identifiers (04 §9 事件; BR-ID-16, BR-ID-32 细则)"
        }
      },
      "required": ["event"]
    }
  },
  "levels": {
    "L0": "Whitelisted origin, main frame",
    "L1": "L0 + logged in",
    "L2": "L1 + user gesture within the last 1 second"
  },
  "errors": {
    "90001": "Method does not exist or is not supported",
    "90002": "Invalid params",
    "90003": "Timeout",
    "90004": "Cancelled by the user",
    "90401": "Not logged in",
    "90403": "Origin or frame not allowed, method + path outside signed_paths, or the method's own whitelist rejection (methods with whitelist_90403: ext.openApp trade_only targets, ext.openBrowser addresses matching link_patterns, share.open links outside the allowed range; 03 §5.3)",
    "90404": "User gesture missing",
    "90500": "Native internal error; also for calls not executed under the force-update guard (03 §4.4)"
  },
  "signed_paths": [
    {
      "method": "POST",
      "path": "/v1/orders/claims"
    }
  ],
  "not_exposed": [
    "withdrawal",
    "payout account change",
    "labor agreement signing",
    "real-name verification",
    "account deletion",
    "phone number change"
  ],
